# ================================================================
# 同花顺 iFinD 数据接口配置
# ================================================================
# 官方注册/SDK下载：https://quantapi.10jqka.com.cn
#
# 三步快速接入：
#   1. 到上面网址免费注册 iFinD 账号
#   2. 下载 SDK 安装包 → 安装 → 运行 SuperCommand.exe
#      → 点右上角「环境修复」→ 选当前项目的 Python.exe
#      → 它会自动在 site-packages 下生成 iFinDPy.pth
#   3. 填好下面 4 个字段，运行：python check_ifind_setup.py
#
# 免费版每月额度（够用）：
#   实时行情 300万单元格/月  |  历史K线 100万/月
#   财务数据 60万/月         |  智能问财 4000次/月
# ================================================================

# 是否启用 iFinD 数据源（true=启用,false=只用免费的akshare+腾讯）
IFIND_ENABLED=true

# 是否优先使用 iFinD（true=先尝试iFinD，失败才回退免费接口；false=只在免费接口失败时兜底）
IFIND_PREFER=true

# 同花顺 iFinD 账号（必填）
IFIND_USERNAME=

# 同花顺 iFinD 密码（必填）
IFIND_PASSWORD=
